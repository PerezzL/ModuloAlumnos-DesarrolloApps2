# Copiar a .env y ajustar. Todas las URLs externas son configuración (AGENTS.md).
# Los valores por defecto apuntan al CORE falso local.

# --- BFF (apps/bff) ---
BFF_PORT=3000
LOG_LEVEL=info
# Gateway de CORE: el BFF llama a los demás módulos solo por acá
GATEWAY_URL=http://localhost:4000
# Tiempo máximo de cada llamada del BFF a un módulo. Menor que los 10 s del Gateway, para que
# el 504 diga qué módulo tardó
GATEWAY_TIMEOUT_MS=8000
# Validación local del JWT
JWKS_URL=http://localhost:4000/.well-known/jwks.json
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=uadenet
# Secreto de la firma X-Core-Signature del Gateway. Lo comparten el BFF y el CORE falso.
# Este valor es solo de desarrollo: el de CORE real lo pasa CORE por privado y va en Railway
CORE_SIGNATURE_SECRET=secreto-de-desarrollo
# Prefijo de cada módulo externo detrás del Gateway
PREFIJO_DOCENTE=/api/v1/teacher
PREFIJO_COMEDOR=/api/v1/dining
PREFIJO_TIENDA=/api/v1/store
PREFIJO_EVENTOS=/api/v1/events
PREFIJO_ACADEMICO=/api/v1/academic
# Token de servicio de CORE (student-service). Con él se leen las rutas internas de Backoffice,
# que no pasan por el Gateway. El CORE falso acepta estas credenciales de desarrollo; las reales
# las pasó CORE por privado y van en Railway
SERVICE_TOKEN_URL=http://localhost:4000/internal/v1/service-auth/token
SERVICE_CLIENT_ID=student-service
SERVICE_CLIENT_SECRET=secreto-de-servicio-de-desarrollo
# Lecturas internas de Backoffice, con /internal/v1 incluido. El CORE falso las sirve en
# /backoffice/internal/v1; la real es https://backend-production-e464.up.railway.app/internal/v1
BACKOFFICE_INTERNAL_URL=http://localhost:4000/backoffice/internal/v1

# --- CORE falso (apps/core-falso) ---
CORE_PORT=4000
# Adónde reenvía el Gateway /api/v1/student/*, con la base incluida.
# BFF: http://localhost:3000/api/v1 · Prism (mock del contrato): http://localhost:4010
STUDENT_SERVICE_URL=http://localhost:3000/api/v1
# Destino real de los demás módulos, con la base incluida. Vacío: responde el módulo falso
# desde packages/fixtures
# TEACHER_SERVICE_URL=
# DINING_SERVICE_URL=
# STORE_SERVICE_URL=
# EVENTS_SERVICE_URL=
# BACKOFFICE_SERVICE_URL=
# ACADEMIC_SERVICE_URL=
# Fallas simuladas al arrancar (caido → 503, invalido → 502, lento → 504; lento:3000 demora 3 s).
# También se cambian en caliente con PUT/DELETE /__falso/fallas/{modulo}
CORE_FALLAS=
# Origen del front, para CORS con credenciales (cookie de refresh)
WEB_ORIGIN=http://localhost:5173

# --- Prism (mock del contrato del BFF) ---
PRISM_PORT=4010

# --- Front (apps/web). Solo las VITE_* llegan al navegador ---
VITE_GATEWAY_URL=http://localhost:4000
VITE_NOTIFICATIONS_URL=http://localhost:4000/notifications
# Portales externos a los que llevan las notificaciones. También son la lista de destinos
# externos permitidos. Biblioteca: la demo publicada del Módulo 3.
VITE_BIBLIOTECA_URL=https://asignia.app/uade-net
VITE_EVENTOS_URL=https://eventos.uadenet.example
# true: login, refresh y logout van al propio origen y el nginx del front los reenvía a CORE
# (solo en el despliegue; en local no hace falta, porque todo es localhost)
VITE_AUTH_PROXY=false
