{
  "name": "@uadenet/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos generados desde openapi.yaml. No editar src/generated a mano.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "gen": "openapi-typescript ../../openapi.yaml -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
