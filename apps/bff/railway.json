{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/bff/Dockerfile",
    "watchPatterns": [
      "apps/bff/**",
      "packages/**",
      "openapi.yaml",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
