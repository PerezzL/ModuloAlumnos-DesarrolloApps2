# Plantilla: la imagen de nginx reemplaza ${PORT} y ${CORE_URL} con las variables de entorno al
# arrancar (Dockerfile). Las variables de nginx ($uri) no se tocan.
server {
  listen ${PORT};
  root /usr/share/nginx/html;

  # SPA: toda ruta que no es un archivo va a index.html
  location / {
    try_files $uri /index.html;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Reenvío de login, refresh y logout a CORE, para que la cookie de refresh quede en el
  # dominio del portal (SameSite=Lax; docs/integracion-real.md, "Despliegue"). Solo se usa si el
  # front se compiló con VITE_AUTH_PROXY=true. La ruta se conserva: la cookie trae
  # Path=/api/v1/auth. CORE_URL va sin "/" final; si no, nginx recorta la ruta.
  location /api/v1/auth/ {
    proxy_pass ${CORE_URL};
    proxy_ssl_server_name on;
  }
}
