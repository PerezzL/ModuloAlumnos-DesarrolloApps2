{
  "name": "uadenet-portal-estudiante",
  "private": true,
  "description": "UADEnet — Módulo 1: Portal del Estudiante (frontend + BFF)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run gen && concurrently -k -n core,bff,web -c magenta,blue,green \"npm run dev -w @uadenet/core-falso\" \"npm run dev -w @uadenet/bff\" \"npm run dev -w @uadenet/web\"",
    "gen": "npm run gen -w @uadenet/api-types",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:contrato": "redocly lint openapi.yaml",
    "test": "npm run gen && vitest run",
    "verify": "npm run gen && npm run typecheck && npm run lint && npm run lint:contrato && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postman": "node -e \"require('fs').mkdirSync('postman',{recursive:true})\" && openapi2postmanv2 -s openapi.yaml -o postman/portal-estudiante.postman_collection.json -p -O folderStrategy=Tags",
    "mock": "prism mock openapi.yaml -p 4010 -h 0.0.0.0",
    "build": "npm run gen && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.57.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "openapi-to-postmanv2": "^6.3.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
